---
interface Props {
  category: string;
  categoryLabel: string;
  slug: string;
  name: string;
  image: string;
  imageAlt: string;
  tagline: string;
}
const { category, categoryLabel, slug, name, image, imageAlt, tagline } = Astro.props;
---
<a class="card" href={`/products/${category}/${slug}/`}>
  <img src={image} alt={imageAlt} loading="lazy" width="800" height="600" />
  <div class="card-body">
    <span class="tag">{categoryLabel}</span>
    <h3>{name}</h3>
    <p>{tagline}</p>
  </div>
</a>
