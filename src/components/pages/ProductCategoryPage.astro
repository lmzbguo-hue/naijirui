---
import Base from '../../layouts/Base.astro';
import QuoteCTA from '../QuoteCTA.astro';
import ProductCard from '../ProductCard.astro';
import { t, ta, U, langPath } from '../../i18n';

interface Props { lang: string; cat: any; list: any[]; }
const { lang, cat, list } = Astro.props;
const u = U(lang);
const canonical = `/products/${cat.slug}/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://naijirui.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://naijirui.com/products/' },
    { '@type': 'ListItem', position: 3, name: t(cat.name, lang), item: 'https://naijirui.com' + canonical },
  ],
};
---
<Base lang={lang} title={t(cat.seoTitle, lang)} description={t(cat.seoDesc, lang)} canonical={canonical} jsonLd={[breadcrumbJsonLd]}>
  <div class="page-head">
    <div class="container">
      <div class="crumbs">
        <a href={langPath(lang, '/')}>{u.products.homeCrumbs}</a> / <a href={langPath(lang, '/products/')}>{u.products.productsCrumbs}</a> / {t(cat.name, lang)}
      </div>
      <h1>{t(cat.h1, lang)}</h1>
      <p>{t(cat.intro, lang)}</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">{u.products.featKicker}</div>
        <h2>{u.products.featH2}</h2>
      </div>
      <ul class="features" style="max-width:820px;margin:0 auto">
        {ta(cat.features, lang).map((f: string) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">{u.products.modelsKicker}</div>
        <h2>{t(cat.name, lang)}</h2>
      </div>
      <div class="grid grid-3">
        {list.map((p: any) => (
          <ProductCard category={cat.slug} categoryLabel={t(cat.short, lang)} slug={p.slug} name={t(p.name, lang)} image={p.image} imageAlt={t(p.imageAlt, lang)} tagline={t(p.tagline, lang)} />
        ))}
      </div>
    </div>
  </section>

  <QuoteCTA lang={lang} heading={t({ en: `Need a quote for ${t(cat.short, 'en').toLowerCase()} units?`, zh: `需要 ${t(cat.short, 'zh')} 的报价？`, ar: `تحتاج عرض سعر لوحدات ${t(cat.short, 'ar')}؟`, fr: `Besoin d'un devis pour les ${t(cat.short, 'fr').toLowerCase()} ?` }, lang)} sub={t({ en: 'Send your quantity, site location and timeline — our export team replies within 24 hours.', zh: '发送您的数量、现场位置与工期——外贸团队24小时内回复。', ar: 'أرسل الكمية وموقع المشروع والجدول الزمني — فريق التصدير يرد خلال 24 ساعة.', fr: 'Envoyez quantité, lieu et délais — notre équipe export répond sous 24 h.' }, lang)} />
</Base>
