---
import Base from '../../layouts/Base.astro';
import categories from '../../data/categories.json';
import { t, ta, U, langPath } from '../../i18n';

interface Props { lang: string; }
const { lang } = Astro.props;
const u = U(lang);
const canonical = '/products/';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://naijirui.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://naijirui.com/products/' },
  ],
};
---
<Base
  lang={lang}
  title={t({ en: 'Prefab Houses, Container Houses & Modular Homes | Products | NJRUI', zh: '预制房屋、集装箱房与模块化住宅 | 产品中心 | NJRUI', ar: 'منازل جاهزة وحاويات ومنازل معيارية | المنتجات | NJRUI', fr: 'Maisons préfabriquées, conteneurs et maisons modulaires | Produits | NJRUI' }, lang)}
  description={t({ en: 'Explore NJRUI product range: folding expandable container houses, flat pack houses, modular prefab houses, site camp accommodation and prefab villas. OEM/ODM. Get a quote.', zh: '浏览奈吉瑞产品系列：折叠扩展箱房、打包箱房、模块化预制房屋、工地营地房与预制别墅。支持OEM/ODM。获取报价。', ar: 'استكشف مجموعة منتجات NJRUI: منازل حاويات قابلة للطي، منازل مسطحة، منازل معيارية جاهزة، معسكرات مواقع وفلل جاهزة. OEM/ODM. اطلب عرض سعر.', fr: 'Découvrez la gamme NJRUI : pliables extensibles, à plat, modulaires, camps et villas. OEM/ODM. Devis.' }, lang)}
  canonical={canonical}
  jsonLd={[breadcrumbJsonLd]}
>
  <div class="page-head">
    <div class="container">
      <div class="crumbs"><a href={langPath(lang, '/')}>{u.products.homeCrumbs}</a> / {u.products.productsCrumbs}</div>
      <h1>{u.products.h1}</h1>
      <p>{u.products.p}</p>
    </div>
  </div>

  <section class="section">
    <div class="container cat-flex">
      {categories.map((c) => (
        <a class="card" href={langPath(lang, `/products/${c.slug}/`)}>
          <img src={c.image} alt={t(c.imageAlt, lang)} loading="lazy" width="800" height="600" />
          <div class="card-body">
            <h3>{t(c.name, lang)}</h3>
            <p>{ta(c.features, lang).slice(0, 3).join(' · ')}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
