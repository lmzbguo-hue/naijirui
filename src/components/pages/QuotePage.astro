---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../QuoteForm.astro';
import { t, U, langPath } from '../../i18n';

interface Props { lang: string; }
const { lang } = Astro.props;
const u = U(lang);
const canonical = '/get-a-quote/';
---
<Base
  lang={lang}
  title={t({ en: 'Get A Quote — Prefab House & Container House Pricing | NJRUI', zh: '获取报价——预制房与集装箱房询价 | NJRUI', ar: 'اطلب عرض سعر — أسعار المنازل الجاهزة والحاويات | NJRUI', fr: 'Demander un devis — prix maisons préfabriquées et conteneurs | NJRUI' }, lang)}
  description={t({ en: 'Request a quote for prefab houses, container houses, modular homes and site camps. Tell us your configuration and quantity — exact FOB/CIF pricing within 24 hours.', zh: '为预制房、集装箱房、模块化住宅与工地营地询价。告诉我们配置与数量——24小时内给出精确FOB/CIF报价。', ar: 'اطلب عرض سعر للمنازل الجاهزة والحاويات والمنازل المعيارية والمعسكرات. أخبرنا بالتهيئة والكمية — عرض FOB/CIF دقيق خلال 24 ساعة.', fr: 'Demandez un devis pour maisons préfabriquées, conteneurs, maisons modulaires et camps. Configuration et quantité — devis FOB/CIF précis sous 24 h.' }, lang)}
  canonical={canonical}
>
  <div class="page-head">
    <div class="container">
      <div class="crumbs"><a href={langPath(lang, '/')}>{u.products.homeCrumbs}</a> / {u.nav.quote}</div>
      <h1>{u.quote.h1}</h1>
      <p>{u.quote.p}</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:880px">
      <div class="section-head">
        <div class="kicker">{u.quote.stepsKicker}</div>
        <h2>{u.quote.stepsH}</h2>
      </div>
      <QuoteForm lang={lang} next={langPath(lang, '/get-a-quote/') + '?sent=1'} />
    </div>
  </section>
</Base>
