---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import site from '../data/site.json';
import { alternates, getDir, langPath } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: string;
  title: string;
  description: string;
  canonical: string; // canonical path WITHOUT lang prefix (same across locales)
  ogImage?: string;
  jsonLd?: any[];
  preloadImage?: string;
}

const { lang, title, description, canonical, ogImage, jsonLd = [], preloadImage } = Astro.props;
const url = site.domain + langPath(lang, canonical);
const alts = alternates(canonical);
const og = ogImage ? site.domain + ogImage : site.domain + '/images/og-default.jpg';
---

<!doctype html>
<html lang={lang} dir={getDir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {alts.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={site.domain + canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary_large_image" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <Header lang={lang} path={canonical} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat />
  </body>
</html>
